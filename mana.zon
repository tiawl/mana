.{
    .@"api version" = .{
        .@"docker/docker_version" = .{
            .endpoint = "/version",
            .version = "v1.56",
            .method = .GET,
        },
        .@"jq/get_api_version" = .{
            .filter = ".[\"docker/docker_version\"][0].ApiVersion | stderr",
            .dependencies = .{
                .@"docker/docker_version",
            },
        },
    },
}
